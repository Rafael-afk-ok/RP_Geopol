{
  "name": "@workspace/geopolitical-rp-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && cp -R migrations dist/migrations",
    "start": "node --enable-source-maps dist/src/index.js",
    "deploy:commands": "tsx src/deploy-commands.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^13.1.1",
    "discord.js": "^14.28.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "catalog:",
    "tsx": "catalog:"
  }
}
